#!/usr/bin/env python3
"""A stand-in for one ``claude -p`` language-model call.

The wrapper under test launches it exactly like the real CLI, with the prompt
on stdin. It reads what to answer from ``$CLAUDE_CONFIG_DIR/fake-lm.json``
(absent means a fenced proposal), records how it was called under
``$CLAUDE_CONFIG_DIR/fake-lm-calls/``, and prints its reply as stream-json,
a ``nonzero`` reply printing the quota event first when it was given one.
Stdlib only, so it runs under whichever ``python3`` is on the child's PATH.
Never used outside the tests.

Its init event reports the ``--model`` and ``--tools`` its argv gave it
(``fake-lm`` and no tools without them), unless the control file's ``model``
or ``tools`` key overrides them, and reports the ``mcp_servers`` and
``slash_commands`` that file names -- neither of those two ever from argv.
It also reports a ``session_id`` numbering this profile's calls from one and
an ``apiKeySource`` of ``none``, both overridable the same way. Its success
result carries the control file's ``cost`` as ``total_cost_usd``, passed
through as given: a string, or ``null``, reaches the event unconverted.

The control file can also make the stub report less than it knows.
``no_init`` suppresses the init event alone, so a quota event still prints
without one; ``omit_init`` and ``omit_result`` drop the keys they name from
the init and from the success result, which is how a consumer is shown to
tell a key reported empty from a key never reported at all. Both must be
lists of key names -- anything else exits 2 rather than match a bare string
against each key in turn. A ``raw`` reply's ``text`` must be a string --
anything else exits 2 rather than print a Python repr that a caller would
read as JSON.
"""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path

ARGS = sys.argv[1:]


def _flag(name: str, default: str | None = None) -> str | None:
    return ARGS[ARGS.index(name) + 1] if name in ARGS else default


def _emit(event: dict) -> None:
    sys.stdout.write(json.dumps(event, sort_keys=True) + "\n")
    sys.stdout.flush()


def _without(event: dict, omitted: list | None) -> dict:
    return {key: value for key, value in event.items() if key not in (omitted or ())}


def _emit_preamble(control: dict, number: int) -> None:
    # ``ClaudeCliCall.argv`` never varies these two flags: it always passes
    # ``--tools ""`` and never ``--mcp-config``, so a call through it can
    # only ever derive an empty surface from its argv. The control file is
    # the one way to make the stub claim a surface it was not given, and
    # claiming one it was not given is the lie a caller asserting on this
    # event exists to catch.
    tools = [tool for tool in (_flag("--tools") or "").split(",") if tool]
    # ``slash_commands`` has no flag in this argv at all: the session lists
    # the skills it found on disk, which the design spec measured as
    # surviving ``--tools ""`` -- named, so not invocable, but still in the
    # prompt. That leak is recorded and accepted, so the manifest has to
    # state it -- and a consumer can only be shown to state it against a stub
    # whose list is not empty. The control file is the only way to fill one.
    # ``--model``, unlike those two, does arrive with a real value, so its
    # control key buys something different: it lets the stub report a model
    # other than the one its caller asked for. Only against a stub that can
    # disagree with its own flag can a consumer be shown to record the model
    # the session reported rather than the model it requested.
    #
    # Reporting nothing and reporting an empty surface are different claims,
    # and a guard that runs only when an init is present can be shown to
    # have a hole only against a session that sends none -- what ``no_init``
    # makes reachable. It suppresses the init alone: the quota event below
    # has its own key, and silencing that too would make ``rate_limit``
    # inert whenever both keys were set.
    if not control.get("no_init"):
        _emit(
            _without(
                {
                    "type": "system",
                    "subtype": "init",
                    "session_id": control.get("session_id", f"fake-lm-{number}"),
                    "model": control.get("model", _flag("--model", "fake-lm")),
                    "tools": control.get("tools", tools),
                    "mcp_servers": control.get("mcp_servers", []),
                    "slash_commands": control.get("slash_commands", []),
                    "apiKeySource": control.get("apiKeySource", "none"),
                },
                control.get("omit_init"),
            )
        )
    if "rate_limit" in control:
        _emit({"type": "rate_limit_event", "rate_limit_info": control["rate_limit"]})


def main() -> int:
    profile = Path(os.environ["CLAUDE_CONFIG_DIR"])
    control_path = profile / "fake-lm.json"
    control = json.loads(control_path.read_text()) if control_path.exists() else {}
    prompt = sys.stdin.read()

    calls = profile / "fake-lm-calls"
    calls.mkdir(exist_ok=True)
    number = len(list(calls.iterdir())) + 1
    (calls / f"{number}.json").write_text(
        json.dumps(
            {
                "argv": sys.argv,
                "env": dict(os.environ),
                "stdin": prompt,
                "cwd": os.getcwd(),
            },
            indent=2,
            sort_keys=True,
        )
    )

    for key in ("omit_init", "omit_result"):
        if not isinstance(control.get(key, []), list):
            # ``_without`` tests ``key not in omitted``, so a bare string was
            # a substring match: ``"omit_init": "tools"`` dropped ``tools`` by
            # accident, a shorter one dropped nothing, and a longer one could
            # drop several. A stub that exists to lie exactly as instructed
            # must refuse an instruction it can only approximate.
            sys.stderr.write(
                f"control file: {key!r} must be a list of key names, "
                f"not {type(control[key]).__name__}\n"
            )
            return 2

    reply = control.get("reply", "fenced")
    if reply == "nonzero":
        if "rate_limit" in control:
            _emit_preamble(control, number)
        sys.stderr.write(control.get("stderr", "the stub was told to fail\n"))
        return int(control.get("exit_code", 3))
    if reply == "hang":
        time.sleep(float(control.get("seconds", 30)))
        return 0
    if reply == "garbage":
        sys.stdout.write("this is not stream-json\n")
        return 0

    _emit_preamble(control, number)
    if reply == "error":
        _emit(
            {
                "type": "result",
                "subtype": "error_during_execution",
                "is_error": True,
                "result": control.get("message", "the stub was told to error"),
                "num_turns": 0,
            }
        )
        return 0
    if reply == "verdict":
        text = json.dumps(
            {"score": control.get("score", 1), "rationale": "stub verdict"}
        )
    elif reply == "raw":
        text = control.get("text", "")
        if not isinstance(text, str):
            # ``str()`` on a mapping yields a Python repr -- single-quoted,
            # so not JSON -- which a caller reading this reply as a payload
            # would take for text and then fail to parse. Refuse instead.
            sys.stderr.write(
                f"raw reply: 'text' must be a string, not {type(text).__name__}\n"
            )
            return 2
    else:
        text = "```\n" + str(control.get("proposal", "PROPOSAL")) + "\n```"
    _emit(
        {
            "type": "assistant",
            "message": {
                "role": "assistant",
                "content": [{"type": "text", "text": text}],
            },
        }
    )
    _emit(
        _without(
            {
                "type": "result",
                "subtype": "success",
                "is_error": False,
                "result": text,
                "num_turns": 1,
                "total_cost_usd": control.get("cost", 0.0),
            },
            control.get("omit_result"),
        )
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
