#!/usr/bin/env python3
"""A stand-in for one ``claude -p`` language-model call.

The wrapper under test launches it exactly like the real CLI, with the prompt
on stdin. It reads what to answer from ``$CLAUDE_CONFIG_DIR/fake-lm.json``
(absent means a fenced proposal), records how it was called under
``$CLAUDE_CONFIG_DIR/fake-lm-calls/``, and prints its reply as stream-json,
a ``nonzero`` reply printing the quota event first when it was given one.
Stdlib only, so it runs under whichever ``python3`` is on the child's PATH.
Never used outside the tests.

Its init event reports the ``--model`` and ``--tools`` its argv gave it
(``fake-lm`` and no tools without them), unless the control file's ``model``
or ``tools`` key overrides them, and the servers named by the control file's
``mcp_servers`` key -- never by argv. Its success result carries the control
file's ``cost`` as ``total_cost_usd``.
"""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path

ARGS = sys.argv[1:]


def _flag(name: str, default: str | None = None) -> str | None:
    return ARGS[ARGS.index(name) + 1] if name in ARGS else default


def _emit(event: dict) -> None:
    sys.stdout.write(json.dumps(event, sort_keys=True) + "\n")
    sys.stdout.flush()


def _emit_preamble(control: dict) -> None:
    # ``ClaudeCliCall.argv`` is fixed: it always passes ``--tools ""`` and
    # never ``--mcp-config``, so a call through it can only ever derive an
    # empty surface from its argv. The control file is the one way to make
    # the stub claim a surface it was not given, and claiming one it was not
    # given is the lie a caller asserting on this event exists to catch.
    tools = [tool for tool in (_flag("--tools") or "").split(",") if tool]
    # ``--model``, unlike those two, does arrive with a real value, so its
    # control key buys something different: it lets the stub report a model
    # other than the one its caller asked for. Only against a stub that can
    # disagree with its own flag can a consumer be shown to record the model
    # the session reported rather than the model it requested.
    _emit(
        {
            "type": "system",
            "subtype": "init",
            "model": control.get("model", _flag("--model", "fake-lm")),
            "tools": control.get("tools", tools),
            "mcp_servers": control.get("mcp_servers", []),
        }
    )
    if "rate_limit" in control:
        _emit({"type": "rate_limit_event", "rate_limit_info": control["rate_limit"]})


def main() -> int:
    profile = Path(os.environ["CLAUDE_CONFIG_DIR"])
    control_path = profile / "fake-lm.json"
    control = json.loads(control_path.read_text()) if control_path.exists() else {}
    prompt = sys.stdin.read()

    calls = profile / "fake-lm-calls"
    calls.mkdir(exist_ok=True)
    number = len(list(calls.iterdir())) + 1
    (calls / f"{number}.json").write_text(
        json.dumps(
            {
                "argv": sys.argv,
                "env": dict(os.environ),
                "stdin": prompt,
                "cwd": os.getcwd(),
            },
            indent=2,
            sort_keys=True,
        )
    )

    reply = control.get("reply", "fenced")
    if reply == "nonzero":
        if "rate_limit" in control:
            _emit_preamble(control)
        sys.stderr.write(control.get("stderr", "the stub was told to fail\n"))
        return int(control.get("exit_code", 3))
    if reply == "hang":
        time.sleep(float(control.get("seconds", 30)))
        return 0
    if reply == "garbage":
        sys.stdout.write("this is not stream-json\n")
        return 0

    _emit_preamble(control)
    if reply == "error":
        _emit(
            {
                "type": "result",
                "subtype": "error_during_execution",
                "is_error": True,
                "result": control.get("message", "the stub was told to error"),
                "num_turns": 0,
            }
        )
        return 0
    if reply == "verdict":
        text = json.dumps(
            {"score": control.get("score", 1), "rationale": "stub verdict"}
        )
    elif reply == "raw":
        text = str(control.get("text", ""))
    else:
        text = "```\n" + str(control.get("proposal", "PROPOSAL")) + "\n```"
    _emit(
        {
            "type": "assistant",
            "message": {
                "role": "assistant",
                "content": [{"type": "text", "text": text}],
            },
        }
    )
    _emit(
        {
            "type": "result",
            "subtype": "success",
            "is_error": False,
            "result": text,
            "num_turns": 1,
            "total_cost_usd": float(control.get("cost", 0.0)),
        }
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
